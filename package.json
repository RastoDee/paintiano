{
  "name": "paintiano",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Music → φ painting. Turn MIDI / audio / images / typed song names into a colored chord painting on the golden-ratio grid.",
  "scripts": {
    "dev": "vite",
    "check": "node check-paintiano.js",
    "build": "node check-paintiano.js && node build-paintiano.js && vite build",
    "preview": "vite preview --host",
    "ios:web": "node scripts/ios-web.mjs",
    "ios:sync": "node scripts/ios-web.mjs && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capgo/native-purchases": "8.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
