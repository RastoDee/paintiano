{
  "appId": "app.paintiano",
  "appName": "Paintiano",
  "webDir": "ios-web",
  "backgroundColor": "#06060c",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#06060c",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SystemBars": {
      "style": "DARK"
    }
  },
  "android": {
    "backgroundColor": "#06060c",
    "allowMixedContent": false
  }
}
